{
  "name": "@medixo/api",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch -r tsconfig-paths/register src/main.ts",
    "start:dev": "npm run dev",
    "build": "tsc -p tsconfig.json",
    "start": "node -r tsconfig-paths/register dist/main.js",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@prisma/client": "^6.19.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.5.0",
    "fuse.js": "^7.3.0",
    "groq-sdk": "^1.1.1",
    "next": "16.1.6",
    "next-auth": "^4.24.13",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tsconfig-paths": "^4.2.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.43",
    "prisma": "^6.19.2",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
